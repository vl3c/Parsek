{
    "model": "claude-fable-5-1",
    "effortLevel": "high",
    "env": {
        "CLAUDE_CODE_SUBAGENT_MODEL": "claude-opus-5",
        "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "4"
    },
    "hooks": {
        "SessionStart": [
            {
                "matcher": "startup|resume",
                "hooks": [
                    {
                        "type": "command",
                        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
                    }
                ]
            }
        ]
    }
}
