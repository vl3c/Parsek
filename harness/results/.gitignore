# Generated per-run result records + rolling summary (never committed).
*.json
summary.txt
*.log
.pending/
# Run-id stakes (exclusive-create, never reaped by design - see run.py
# _try_claim_run_id). A COMMITTED stake would permanently burn that run id for
# every clone, so this pattern is load-bearing, not tidiness.
*.claim
# V3 always-collect artifacts + contact sheets (generated per run; never committed).
*_shots/
# The run's own copy of the produced save (run.py _snapshot_produced_save). Tens
# of MB per run, bounded by the per-scenario retention pass; a fixture harvested
# from one IS committed, under harness/fixtures/saves/ - the snapshot never is.
*_save/
*_save.harness-tmp/
*.html
*.html.tmp.*
# Tier-runner output: per-invocation dated logs + the history.txt skim surface
# (tools/tier_runner.py). Local run evidence, never committed.
tier-runs/
